# ==============================================================================
# CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# Copiez ce fichier sous le nom '.env' pour vos tests en local.
# Ne committez JAMAIS votre fichier '.env' réel dans GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE AI STUDIO (Gemini 1.5 Pro)
# Obtenez votre clé sur : https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-pro"

# ------------------------------------------------------------------------------
# 2. SUPABASE (Base de Données PostgreSQL)
# Obtenez vos clés dans : Supabase > Project Settings > API
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
# Utilisez la clé 'anon' pour l'app Streamlit et 'service_role' pour le runner GitHub Actions
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. GOOGLE WORKSPACE (Gmail API & Google Chat API)
# Plusieurs modes d'authentification sont supportés :
# ------------------------------------------------------------------------------
# Mode A : OAuth 2.0 Client (recommandé en local via setup_google_auth.py)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Mode B : Fichier Service Account JSON (chemin local ou chaîne JSON)
GOOGLE_SERVICE_ACCOUNT_FILE="service_account.json"
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# Mode C : Base64 de votre token.json ou service_account.json (Idéal pour GitHub Secrets)
# Pour générer : [Convert]::ToBase64String([IO.File]::ReadAllBytes('token.json'))
GOOGLE_CREDENTIALS_BASE64=""

# Utilisateur délégué (requis si Service Account avec délégation de domaine Google Workspace)
GOOGLE_DELEGATED_USER_EMAIL=""

# ------------------------------------------------------------------------------
# 4. PARAMÈTRES D'INGESTION GMAIL & CHAT
# ------------------------------------------------------------------------------
# Libellés Gmail surveillés (séparés par des virgules)
GMAIL_LABELS_FILTER="OneStock via RUN, Notification_DSI, OPCON, trt_stambia"
GMAIL_LOOKBACK_HOURS=24

# Espaces Google Chat ciblés (laisser vide pour scanner tous les espaces accessibles)
GOOGLE_CHAT_SPACES=""

# ------------------------------------------------------------------------------
# 5. PARAMÈTRES STREAMLIT / RENDER
# ------------------------------------------------------------------------------
PORT=8501
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
